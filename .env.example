# Paths are relative to the repository; containers mount it at /workspace.
DATASET_DIR=data/d07-1week-mainline
SAMPLE_DIR=data/sample
RUNS_DIR=data/runs
STATION_LIMIT=100
# 0 means all 201,600 selected events; CI may use 1,200 for a smoke test.
DEMO_EVENT_LIMIT=0
REPLAY_EVENTS_PER_SECOND=5000
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Above address is for container clients. Host clients use localhost:29092.
# Override in the shell when running a module directly on the host.
KAFKA_TOPIC=traffic-events
SPARK_WATERMARK=10 minutes
# Provisional integration baseline; analytics owner must approve.
SEVERE_SPEED_MPH=20
CONGESTED_SPEED_MPH=40
MODERATE_SPEED_MPH=55
